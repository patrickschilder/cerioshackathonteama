{
	"realm": "elearning",
	"enabled": true,
	"displayName": "Cerios Academy",
	"accessTokenLifespan": 300,
	"refreshTokenMaxReuse": 0,
	"ssoSessionMaxLifespan": 36000,
	"roles": {
		"realm": [
			{
				"name": "student",
				"description": "Learner: can view courses, track progress, take quizzes"
			},
			{
				"name": "instructor",
				"description": "Can create courses and upload content"
			},
			{
				"name": "admin",
				"description": "Full access to all resources"
			}
		]
	},
	"clients": [
		{
			"clientId": "api-elearning",
			"name": "E-Learning API",
			"enabled": true,
			"bearerOnly": true,
			"publicClient": false
		},
		{
			"clientId": "admin-portal",
			"name": "Admin Portal",
			"enabled": true,
			"publicClient": true,
			"redirectUris": ["http://localhost:5174/*"],
			"webOrigins": ["http://localhost:5174"],
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": true,
			"protocolMappers": [
				{
					"name": "api-elearning-audience",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-audience-mapper",
					"config": {
						"included.client.audience": "api-elearning",
						"id.token.claim": "false",
						"access.token.claim": "true"
					}
				}
			]
		},
		{
			"clientId": "student-portal",
			"name": "Student Portal",
			"enabled": true,
			"publicClient": true,
			"redirectUris": ["http://localhost:5173/*"],
			"webOrigins": ["http://localhost:5173"],
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": true,
			"protocolMappers": [
				{
					"name": "api-elearning-audience",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-audience-mapper",
					"config": {
						"included.client.audience": "api-elearning",
						"id.token.claim": "false",
						"access.token.claim": "true"
					}
				}
			]
		}
	],
	"users": [
		{
			"username": "admin-user",
			"enabled": true,
			"email": "admin@cerios.nl",
			"firstName": "Admin",
			"lastName": "User",
			"credentials": [
				{
					"type": "password",
					"value": "admin123",
					"temporary": false
				}
			],
			"realmRoles": ["admin"]
		},
		{
			"username": "instructor-user",
			"enabled": true,
			"email": "instructor@cerios.nl",
			"firstName": "Instructor",
			"lastName": "User",
			"credentials": [
				{
					"type": "password",
					"value": "instructor123",
					"temporary": false
				}
			],
			"realmRoles": ["instructor"]
		},
		{
			"username": "student-user",
			"enabled": true,
			"email": "student@cerios.nl",
			"firstName": "Student",
			"lastName": "User",
			"credentials": [
				{
					"type": "password",
					"value": "student123",
					"temporary": false
				}
			],
			"realmRoles": ["student"]
		}
	]
}
